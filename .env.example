# Local Docker Compose maps Postgres to host port 5433
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/atm_locator
JWT_SECRET=dev-only-change-me-to-at-least-32-bytes!!
PORT=3847
HOST=127.0.0.1
WAIT_FRESH_SEC=120
WAIT_AGING_SEC=300
WAIT_DEFAULT_T_SEC=90
GPS_SOFT_RADIUS_M=250
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_WINDOW_SEC=60
OBJECT_STORE_DIR=./storage
PUBLIC_BASE_URL=http://127.0.0.1:3847
# Comma-separated allow-list; omit for reflect-any (local/dev)
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5173
# REDIS_URL=redis://127.0.0.1:6379
